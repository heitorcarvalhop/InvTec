# PROMPT 11.3.4 — SUPABASE_ENV declara explicitamente qual projeto este
# .env aponta (producao/homologacao). Nunca inferido do nome do arquivo:
# EnvConfig.isProducao só é true quando esta chave é literalmente
# "producao". Sem essa chave, o app trata o ambiente como "não declarado"
# (nunca presume produção) e mostra uma faixa vermelha na tela.
SUPABASE_ENV=producao
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# PROMPT 11.6.5/11.6.6 — trava operacional da execução real do modo ADMIN
# "Comparar e Atualizar" (independente de perfil/kReleaseMode). Ausente ou
# qualquer valor diferente de "true" mantém a execução DESABILITADA.
COMPARACAO_EXECUCAO_HABILITADA=false
