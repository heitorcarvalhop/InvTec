# Declara explicitamente qual projeto Supabase este .env aponta
# (producao/homologacao). Sem esta chave, o app trata o ambiente como "não
# declarado" e nunca presume produção.
SUPABASE_ENV=producao
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Libera a execução real do modo ADMIN "Comparar e Atualizar". Ausente ou
# qualquer valor diferente de "true" mantém a execução desabilitada.
COMPARACAO_EXECUCAO_HABILITADA=false
