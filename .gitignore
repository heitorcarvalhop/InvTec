# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
Thumbs.db
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Environment variables (contêm credenciais, nunca versionar).
.env*
!.env.example

# PROMPT 11.3.4.1 — env/*.env (consumidos via --dart-define-from-file para
# selecionar produção/homologação explicitamente no comando de build/
# execução, substituindo a troca manual de .env do PROMPT 11.3.4). Os
# TEMPLATES .example continuam versionados.
env/*.env
!env/*.env.example

# Estado local do Claude Code (lock files de sessão, não é código do projeto)
.claude/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Dados reais usados apenas para testes locais
local_test_data/

# Pacote de distribuição (ZIP + pasta Release copiada) — artefato gerado,
# nunca versionado; regenerado por `flutter build windows --release` + empacotamento manual.
/dist/
*.zip

# Estado local do Supabase CLI (cache de versão/projeto, não é código do projeto).
supabase/.temp/